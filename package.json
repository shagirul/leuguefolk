{
  "name": "agree-firebase-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase-only offline-first invite leaderboard PWA",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only auth,firestore --project demo-agree \"node --test tests/profile-rules.emulator.cjs tests/groups-matches.emulator.cjs tests/password-reset.emulator.cjs tests/phase1.emulator.cjs\"",
    "serve": "npx firebase-tools emulators:start --only hosting",
    "invites:backfill": "node scripts/backfill-invite-players.mjs",
    "deploy": "npx firebase-tools deploy --only hosting,firestore",
    "build:ratings": "node scripts/build-ratings.mjs",
    "simulate:ratings": "node scripts/simulate-ratings.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.35.0"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "openskill": "5.0.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "glob@>=9.0.0 <=14.0.1": "14.0.2",
    "uuid@<11.1.1": "11.1.1",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.8.0"
    }
  }
}
